{
  "name": "express-ts-app",
  "version": "0.2.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bunx --bun tsc --project tsconfig.json",
    "lint": "bunx --bun eslint .",
    "fixLint": "bunx --bun eslint . --fix",
    "format": "bunx --bun prettier --write .",
    "prisma:reset": "bunx --bun prisma migrate reset --force",
    "prisma:generate": "bunx --bun prisma generate",
    "seed": "bun prisma/seed.ts",
    "cleanup": "bun scripts/cleanup.ts",
    "studio": "bunx --bun prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.3.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/cors": "^2.8.19",
    "arctic": "^3.7.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  }
}
