PORT=6767
NODE_ENV=development

DATABASE_URL=postgresql://<username>:<password>@localhost:5433/kauth?schema=public

# Must be at least 32 characters in production; the app refuses to start otherwise.
JWT_SECRET=my-jwt-secret
COOKIE_SECRET=my-cookie-secret

# Where the browser app lives. Used for email links and the OAuth return trip.
FRONTEND_URL=http://localhost:5173
# The auth server's own public origin. Used to build OAuth callback URLs.
APP_URL=http://localhost:6767

# Number of reverse proxies in front of the app, or "false" when exposed
# directly. A wrong value corrupts req.ip, which the audit log and the IP rate
# limiters both depend on.
TRUST_PROXY=false

# Comma-separated origins allowed to make state-changing requests.
# Defaults to FRONTEND_URL and APP_URL.
# TRUSTED_ORIGINS=http://localhost:5173,http://localhost:6767

# Refuse credential logins until the address is confirmed. Leave off until a
# real mail transport is wired up, or nobody can sign in.
REQUIRE_EMAIL_VERIFICATION=false

# Social login. A provider is enabled only when both halves are present.
# Callback URL to register with the provider: <APP_URL>/oauth/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Only read by the test suite; defaults to a kauth_test database on the dev host.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5433/kauth_test?schema=public
