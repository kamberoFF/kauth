generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id   String @id @default(uuid()) @db.Uuid
  name String

  /**
   * Per-project CORS/CSRF allowlist. Replaces the single global
   * config.trusted_origins once a project can configure its own — not wired
   * into requireTrustedOrigin/app.ts's cors() yet, that's a later ticket.
   */
  trusted_origins String[] @default([])

  /**
   * Per-project minimum password length. Nullable means "use the
   * deployment-wide PASSWORD_MIN_LENGTH default" (lib/passwords.ts resolves
   * it); set at creation via POST /projects, changed via PATCH /projects/:id.
   */
  min_password_length Int?

  /**
   * Per-project MFA mandate. Enforcement (grace stamping and the requireAuth
   * wall) lands in a later ticket; the columns exist so the mandate's data
   * model is in place from the start.
   */
  enforce_mfa    Boolean @default(false)
  mfa_grace_days Int?

  /**
   * Nullable: no owner concept exists until the developer-facing auth
   * bootstrap (ticket 03) creates the reserved platform project and its
   * operator accounts. Projects created directly for test/seed purposes
   * before then simply have no owner.
   */
  owner    User?   @relation("ProjectOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  owner_id String? @db.Uuid

  users          User[]
  accounts       Account[]
  sessions       Session[]
  refreshTokens  RefreshToken[]
  recoveryTokens RecoveryToken[]
  securityEvents SecurityEvent[]
  apiKeys        ApiKey[]

  /**
   * Bring-your-own OAuth Provider apps (ADR 0009). Empty means every social
   * login for this Project inherits the instance env credentials.
   */
  oauthCredentials ProjectOAuthCredential[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([owner_id])
  @@map("projects")
}

/**
 * A Project's own OAuth client for a built-in provider (ADR 0009). One row per
 * (project, provider): an `OVERRIDE` replaces the instance env app for that
 * Project with the stored `client_id` / encrypted `client_secret_enc`; a
 * `DISABLED` row suppresses the provider entirely, so the Project's login page
 * offers neither its own app nor the instance's. No row at all means inherit.
 */
model ProjectOAuthCredential {
  id String @id @default(uuid()) @db.Uuid

  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_id String  @db.Uuid

  /**
   * String, not an enum, to match the string-keyed provider registry and to
   * leave room for a `stub` provider id in tests. "google" | "github" today.
   */
  provider_id String

  /**
   * Plaintext on purpose: the client id is public — it rides in every
   * authorization redirect URL — and the owner listing needs to show it.
   */
  client_id String

  /**
   * `lib/cryptoBox.ts` ciphertext under the "kauth:project-oauth" derivation
   * context (ADR 0006's namespaced key rule). Null iff `mode = DISABLED`.
   * Never returned by any endpoint, never put in security-event metadata,
   * never logged.
   */
  client_secret_enc String?

  mode OAuthCredentialMode

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_id, provider_id])
  @@index([project_id])
  @@map("project_oauth_credentials")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  project    Project @relation(fields: [project_id], references: [id], onDelete: Restrict)
  project_id String  @db.Uuid

  email String

  /**
   * Optional because social signups have no username until the user picks one.
   * Postgres allows many NULLs under a unique index, so uniqueness still holds
   * for the users who do have one.
   */
  username String?

  email_verified Boolean @default(false)

  first_name String?
  last_name  String?
  image      String?
  role       Role    @default(USER)

  /**
   * TOTP second factor (ADR 0006). totp_secret holds AES-256-GCM ciphertext
   * from lib/cryptoBox.ts, never the raw base32 secret. mfa_enrolled_at null
   * with a non-null secret means enrollment is pending confirmation; a
   * pending enrollment challenges nothing at sign-in.
   *
   * Deliberately TIMESTAMP(3), not TIMESTAMPTZ as the MFA spec's DDL sketch
   * wrote: every DateTime in this schema maps that way, and mixing time
   * regimes across columns costs more than the annotation would buy.
   */
  totp_secret      String?
  mfa_enrolled_at  DateTime?
  mfa_grace_ends_at DateTime?

  /**
   * Last successfully matched TOTP time step. Any later code at or below it
   * is a replay and must be rejected.
   */
  last_totp_step Int?

  backupCodes MfaBackupCode[]

  accounts       Account[]
  sessions       Session[]
  recoveryTokens RecoveryToken[]
  securityEvents SecurityEvent[]

  /**
   * Projects this user owns as a developer/operator. Populated starting with
   * ticket 03 — always empty for ordinary end users.
   */
  ownedProjects Project[] @relation("ProjectOwner")

  /**
   * API keys this user has issued for a project they own. The key itself
   * authorizes requests as the project, not as this specific developer —
   * this relation exists for audit attribution only.
   */
  issuedApiKeys ApiKey[] @relation("ApiKeyIssuer")

  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@unique([project_id, email])
  @@unique([project_id, username])
  @@index([project_id])
  @@map("users")
}

/**
 * One row per way a user can authenticate. The credential provider stores the
 * password hash; every OAuth provider stores its own subject id and tokens.
 * Keeping them in one table is what lets a user link Google to an account they
 * originally created with a password.
 */
model Account {
  id String @id @default(uuid()) @db.Uuid

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.Uuid

  project    Project @relation(fields: [project_id], references: [id], onDelete: Restrict)
  project_id String  @db.Uuid

  /**
   * "credential" for email+password, otherwise the provider key ("google").
   */
  provider_id String

  /**
   * The provider's stable subject identifier. For the credential provider this
   * is the kauth user id, which keeps the composite unique key meaningful.
   */
  account_id String

  /**
   * Credential provider only. Never populated for OAuth accounts.
   */
  password String?

  access_token            String?
  refresh_token           String?
  id_token                String?
  access_token_expires_at DateTime?
  scope                   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_id, provider_id, account_id])
  @@unique([user_id, provider_id])
  @@index([user_id])
  @@index([project_id])
  @@map("accounts")
}

model Session {
  id      String @id @default(uuid()) @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.Uuid

  project    Project @relation(fields: [project_id], references: [id], onDelete: Restrict)
  project_id String  @db.Uuid

  /**
   * One logical login/browser profile/device session.
   * Do NOT trust this as a physical device identity.
   * It is a server-created session record.
   */

  status SessionStatus @default(ACTIVE)

  created_at     DateTime  @default(now())
  last_used_at   DateTime?
  expires_at     DateTime
  revoked_at     DateTime?
  revoked_reason String?

  /**
   * Optional server-generated install/browser id.
   * Useful for grouping "same browser profile probably",
   * but NOT a security boundary.
   */
  device_id String? @db.Uuid

  /**
   * Human-readable display metadata.
   */
  device_name     String?
  device_type     DeviceType?
  os_name         String?
  os_version      String?
  browser_name    String?
  browser_version String?

  /**
   * Raw-ish metadata for security/risk decisions.
   * Avoid depending on this as proof of identity.
   */
  user_agent_created String?
  user_agent_last    String?

  ip_created String?
  ip_last    String?

  country_created String?
  country_last    String?
  city_created    String?
  city_last       String?

  /**
   * Optional weak fingerprint.
   * Store a hash, not the raw fingerprint object.
   * Use only as risk signal.
   */
  fingerprint_hash String?

  refreshTokens  RefreshToken[]
  securityEvents SecurityEvent[]

  @@index([user_id])
  @@index([user_id, status])
  @@index([device_id])
  @@index([last_used_at])
  @@index([project_id])
  @@map("sessions")
}

model RefreshToken {
  id       String @id @default(uuid()) @db.Uuid
  selector String @unique

  session    Session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  session_id String  @db.Uuid

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.Uuid

  project    Project @relation(fields: [project_id], references: [id], onDelete: Restrict)
  project_id String  @db.Uuid

  /**
   * All rotated tokens for one session share this family_id.
   * If reuse is detected, revoke the whole family/session.
   */
  family_id String @db.Uuid

  /**
   * Store bcrypt hash of opaque random token.
   * NEVER store the raw refresh token.
   */
  token_hash String @unique

  status RefreshTokenStatus @default(ACTIVE)

  created_at           DateTime  @default(now())
  expires_at           DateTime
  consumed_at          DateTime?
  revoked_at           DateTime?
  replaced_by_token_id String?   @db.Uuid

  /**
   * Reuse detection / auditing metadata.
   */
  created_by_ip  String?
  consumed_by_ip String?

  created_by_user_agent  String?
  consumed_by_user_agent String?

  @@index([selector])
  @@index([session_id])
  @@index([user_id])
  @@index([family_id])
  @@index([status])
  @@index([expires_at])
  @@index([project_id])
  @@map("refresh_tokens")
}

model RecoveryToken {
  id String @id @default(uuid()) @db.Uuid

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.Uuid

  project    Project @relation(fields: [project_id], references: [id], onDelete: Restrict)
  project_id String  @db.Uuid

  /**
   * Same idea: opaque random token, store hash.
   * Do NOT store raw password reset/email confirmation tokens.
   */
  token_hash String @unique

  token_type TokenType

  /**
   * MFA_CHALLENGE only: the resolved device id of phase one. Phase two must
   * arrive from the same device, or the challenge is invalid.
   */
  device_id String? @db.Uuid

  created_at  DateTime  @default(now())
  expires_at  DateTime
  consumed_at DateTime?

  @@index([user_id])
  @@index([token_hash])
  @@index([token_type])
  @@index([expires_at])
  @@index([project_id])
  @@map("recovery_tokens")
}

/**
 * Single-use offline stand-ins for a TOTP code, shown exactly once at
 * enrollment confirmation. Stored as SHA-256 hashes for the same reason as
 * recovery tokens: a database leak must not yield working codes.
 */
model MfaBackupCode {
  id String @id @default(uuid()) @db.Uuid

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.Uuid

  code_hash String @unique

  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@map("mfa_backup_codes")
}

model ApiKey {
  id String @id @default(uuid()) @db.Uuid

  project    Project @relation(fields: [project_id], references: [id], onDelete: Restrict)
  project_id String  @db.Uuid

  key_type ApiKeyType

  /**
   * SECRET: the plaintext lookup selector, paired with key_hash — the same
   * selector/verifier split RefreshToken uses for O(1) lookup without a
   * full-table hash scan. PUBLISHABLE: a display-truncated slice of
   * key_value. Either way, a listing shows only this column, never
   * key_value or key_hash.
   */
  key_prefix String @unique

  /**
   * Full plaintext value, PUBLISHABLE only. Safe to store and re-serve in
   * full since these keys are meant to ship in a browser/mobile bundle.
   */
  key_value String? @unique

  /**
   * bcrypt hash of the verifier half, SECRET only. Shown once at creation,
   * never reconstructable afterward.
   */
  key_hash String?

  /**
   * Audit attribution only — the key authorizes requests as the project,
   * not as this user. Nullable so a departed developer's account can be
   * removed without invalidating keys they issued.
   */
  created_by         User?   @relation("ApiKeyIssuer", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  created_by_user_id String? @db.Uuid

  created_at   DateTime  @default(now())
  last_used_at DateTime?
  revoked_at   DateTime?

  @@index([project_id])
  @@index([created_by_user_id])
  @@map("api_keys")
}

model SecurityEvent {
  id String @id @default(uuid()) @db.Uuid

  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String? @db.Uuid

  session    Session? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  session_id String?  @db.Uuid

  project    Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  project_id String?  @db.Uuid

  event_type SecurityEventType
  severity   SecurityEventSeverity @default(INFO)

  ip         String?
  user_agent String?

  metadata Json?

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([session_id])
  @@index([event_type])
  @@index([created_at])
  @@index([project_id])
  @@map("security_events")
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET

  /**
   * Handed to the browser after an OAuth callback and exchanged for a token
   * pair. Very short lived: it exists only to carry the result of a redirect
   * back to the frontend without putting session tokens in a URL.
   */
  OAUTH_EXCHANGE

  /**
   * Bridges phase one (credentials verified) and phase two (code verified)
   * of an enrolled user's sign-in. Single-use, ~5-minute TTL, bound to the
   * device id that started login.
   */
  MFA_CHALLENGE
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RefreshTokenStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN
}

enum ApiKeyType {
  PUBLISHABLE
  SECRET
}

enum OAuthCredentialMode {
  OVERRIDE
  DISABLED
}

enum SecurityEventType {
  USER_REGISTERED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  REFRESH_SUCCESS
  REFRESH_REUSE_DETECTED
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CONFIRMATION_SENT
  EMAIL_CONFIRMED
  OAUTH_LOGIN_SUCCESS
  OAUTH_LOGIN_FAILED
  OAUTH_ACCOUNT_LINKED
  ACCOUNT_UNLINKED
  CSRF_VALIDATION_FAILED
  SUSPICIOUS_ACTIVITY
  API_KEY_ISSUED
  API_KEY_REVOKED
  PROJECT_PASSWORD_POLICY_CHANGED

  /**
   * Second-factor lifecycle. Enrollment is split so a generated-but-unconfirmed
   * secret still leaves a trace; BACKUP_CODE_USED flags that an offline code,
   * not the authenticator, completed the sign-in.
   */
  MFA_ENROLLMENT_STARTED
  MFA_ENROLLED
  MFA_DISABLED
  BACKUP_CODE_USED
  PROJECT_MFA_POLICY_CHANGED

  /**
   * A platform staff member changed a user's role (ADR 0007 scope). WARNING
   * like every privilege transition; metadata carries old_role/new_role and
   * the acting staff id.
   */
  ROLE_CHANGED

  /**
   * A register attempt on an already-registered email (ADR 0008). The
   * response is deliberately indistinguishable from a fresh signup, so this
   * server-side-only event is the only place a repeat attempt on a known
   * address is visible. Attributed to the existing user.
   */
  REGISTER_DUPLICATE_EMAIL

  /**
   * A Project owner changed a Provider app (per-project OAuth credentials,
   * ADR 0009): configured an override, disabled a provider, or cleared a row
   * back to inheriting the instance app. WARNING like the other project-config
   * changes; metadata carries the provider and the action, never the secret
   * or even the client_id.
   */
  PROJECT_OAUTH_CONFIG_CHANGED
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}
